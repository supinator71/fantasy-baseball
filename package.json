{
  "name": "fantasy-baseball",
  "version": "1.0.0",
  "description": "Fantasy MLB Draft Assistant & Season Manager",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"nodemon server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "axios": "^1.6.0",
    "connect-sqlite3": "^0.9.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.17.3",
    "session-file-store": "^1.5.0",
    "stripe": "^22.0.1",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3"
  }
}
